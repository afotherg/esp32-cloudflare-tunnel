CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_SSL_ALPN=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y

# The tunnel requires TLS 1.3; omit unused TLS 1.2 handshake state.
# CONFIG_MBEDTLS_SSL_PROTO_TLS1_2 is not set

# Optimize firmware size to leave more internal RAM available for networking.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Trade peak Wi-Fi throughput for heap needed by four TLS 1.3 connections.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
# Six static RX buffers match the default Wi-Fi block-ack window.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
